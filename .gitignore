# Official PSADT template payload - the CI pipeline downloads the pinned release
# and verifies its hash; a local working copy may have these extracted in place
# under each app folder for local testing.
apps/*/Assets/
apps/*/Config/
apps/*/Files/
apps/*/Strings/
apps/*/PSAppDeployToolkit/
apps/*/PSAppDeployToolkit.Extensions/
apps/*/Invoke-AppDeployToolkit.exe

# Build output
*.intunewin
*.orig

# Scratch folder for manually assembling/testing a build locally (mirrors what CI
# does in $RUNNER_TEMP) - never committed.
.local-build/

# device-inventory-report: CI injects the ingest mutual-TLS client cert into
# SupportFiles at build time from repo secrets - it must never be committed. This
# guards against it ever landing here from local testing.
apps/device-inventory-report/SupportFiles/client-cert.pfx
apps/device-inventory-report/SupportFiles/client-cert.pfx.pw

# onedrive-teamsync: CI injects the OneDrive-TeamSync-App Graph auth certificate into
# SupportFiles at build time from repo secrets - same reasoning as device-inventory-report.
apps/onedrive-teamsync/SupportFiles/onedrive-teamsync-cert.pfx
apps/onedrive-teamsync/SupportFiles/onedrive-teamsync-cert.pfx.pw

# Local-only credential notes - never committed
secret.md
